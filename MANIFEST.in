include README.md
include LICENSE
include pyproject.toml
# rift data plane: proto only — rift-client Go sources/binaries live in
# k8s_middleware/rift (the platform injects them; the SDK ships Python stubs).
recursive-include pyromind_sdk/rift/proto *.proto
recursive-exclude * __pycache__
recursive-exclude * *.py[co]
# Exclude build and development files
exclude build_and_publish.sh
exclude update_version.py

